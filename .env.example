# ===== Apps =====
# Web dev server origin (used as Casdoor redirect_uri base)
WEB_ORIGIN=http://localhost:5173
# API dev server port
API_PORT=4000
# Docs site origin (opened from TopBar docs icon; defaults to http://localhost:5180 in dev)
# VITE_DOCS_URL=http://localhost:5180

# ===== Database =====
# Leave DATABASE_URL empty to use embedded-postgres (dev).
# For production, point to a real PostgreSQL instance:
# DATABASE_URL=postgres://user:pass@host:5432/rabbitpost
DATABASE_URL=
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_DIR=.pgdata

# ===== Casdoor (OIDC) =====
# Your self-hosted Casdoor endpoint, e.g. https://casdoor.example.com
CASDOOR_ENDPOINT=https://your-casdoor.example.com
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# Organization and application name configured in Casdoor
CASDOOR_ORGANIZATION=
CASDOOR_APPLICATION=
# RS256 public certificate (from Casdoor app cert) used to verify id_token
CASDOOR_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ===== Session =====
# Secret used to sign the app session cookie (openssl rand -hex 32)
APP_SESSION_SECRET=change-me-to-a-random-string

# ===== Database connections =====
# AES-256-GCM key for encrypting stored DB connection passwords
# (base64-encoded 32 bytes; generate: openssl rand -base64 32)
DB_SECRET_KEY=
