{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RabbitPost",
  "version": "0.1.0",
  "identifier": "com.rabbitpost.desktop",
  "build": {
    "frontendDist": "../app",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RabbitPost",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "url": "http://localhost:5173"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "externalBin": ["bin/rabbitpost-runner"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
