  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is ok', () => pm.expect(pm.response.json().status).to.equal('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Echo",
      "item": [
        {
          "name": "GET Echo with Params",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/echo?param1=value1&param2=value2",
            "header": [
              {
                "key": "X-Custom-Header",
                "value": "test-value"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Method is GET', () => pm.expect(pm.response.json().method).to.equal('GET'));",
                  "pm.test('Query params echoed', () => {",
                  "  const query = pm.response.json().query;",
                  "  pm.expect(query.param1).to.equal('value1');",
                  "  pm.expect(query.param2).to.equal('value2');",
                  "});",
                  "pm.test('Custom header echoed', () => {",
                  "  pm.expect(pm.response.json().headers['x-custom-header']).to.equal('test-value');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Echo with JSON",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/echo",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"test\",\"value\":123}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body echoed', () => {",
                  "  const body = pm.response.json().body;",
                  "  pm.expect(body.name).to.equal('test');",
                  "  pm.expect(body.value).to.equal(123);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
