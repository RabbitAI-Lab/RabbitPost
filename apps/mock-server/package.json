{
  "name": "@rabbitpost/mock-server",
  "version": "1.0.0",
  "description": "Standalone mock server for RabbitPost testing and validation",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "ts-node scripts/ensure-port.ts && nest start",
    "start:dev": "ts-node scripts/ensure-port.ts && nest start --watch",
    "start:prod": "ts-node scripts/ensure-port.ts && node dist/main",
    "start:safe": "ts-node scripts/ensure-port.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "export:postman": "ts-node scripts/export-postman.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.2.0",
    "raw-body": "^4.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
